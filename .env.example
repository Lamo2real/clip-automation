# Your settings. Never commit .env. The README says where each value comes from.
# Values marked (auto) are filled in for you by infra/deploy.sh or `node studio.mjs auth ...`.

# --- AWS (credentials come from `aws configure`, not from this file) ---
# (auto)
AWS_REGION=
# (auto)
S3_BUCKET=
# (auto)
JOBS_QUEUE_URL=

# --- Epidemic Sound ---
EPIDEMIC_API_KEY=
EPIDEMIC_USER_ID=

# --- Meta: one system-user token covers WhatsApp, Instagram and Facebook ---
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# (auto) your own number, e.g. 46701234567
WHATSAPP_TO=
# (auto)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=video_review
WHATSAPP_TEMPLATE_LANG=en
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# (auto) node studio.mjs auth youtube
YOUTUBE_REFRESH_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# (auto)
TIKTOK_REDIRECT_URI=
# (auto) node studio.mjs auth tiktok
TIKTOK_REFRESH_TOKEN=

# --- Optional: Tella (no longer needed for the automatic pipeline) ---
TELLA_API_KEY=
